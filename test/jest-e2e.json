{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/\\._"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "forceExit": true,
  "maxWorkers": 1,
  "setupFiles": [
    "<rootDir>/support/e2e-database.setup.ts"
  ],
  "globalSetup": "<rootDir>/support/e2e-database.global-setup.ts"
}
